{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm -C FE install --frozen-lockfile",
  "buildCommand": "pnpm -C FE run build",
  "outputDirectory": "FE/dist",
  "rewrites": [
    { "source": "/kiosk", "destination": "/kiosk.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
