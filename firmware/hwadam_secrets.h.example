// 이 파일을 libraries/HwadamSecrets/hwadam_secrets.h 로 복사한 뒤 값을 채운다.
// 복사본은 .gitignore에 의해 커밋되지 않는다.
#pragma once

#define WIFI_SSID   "your-ssid"
#define WIFI_PASS   "your-password"

// 환경 노드(Node_SHT31_v2, Node_Ambient_v1, Node_Storage_v1)가 쓰는 적재 엔드포인트.
#define SERVER_URL  "https://<project-ref>.supabase.co/functions/v1/iot-readings"

// 측정 노드(Node_Optical_v1)가 쓰는 서버 주소.
// 세션 폴링과 측정값 전송이 서로 다른 경로라 전체 URL이 아닌 base만 둔다.
// 끝에 슬래시를 붙이지 않는다.
//
// 배포 환경에서는 IP가 아니라 도메인을 쓴다. Caddy가 이 호스트 이름으로
// 사이트 블록을 가르기 때문에(deploy/Caddyfile), 탄력적 IP로 직접 때리면
// /api/iot/* 라우팅 자체를 타지 못한다.
//
// 로컬 개발이면 "http://192.168.0.10:8000"처럼 PC의 LAN 주소를 쓴다.
// ESP32에게 localhost는 자기 자신이다.
#define SERVER_BASE "https://uhoo08-api.duckdns.org"

#define NODE_KEY    "your-node-key"
